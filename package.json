{
  "name": "clockshot-game",
  "version": "0.0.0",
  "description": "Clockshot — a Reddit community time war. Swing, shoot, and bank seconds for your team.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:watch": "node scripts/watch.mjs",
    "art": "node scripts/make-art.mjs",
    "preview": "vite preview",
    "login": "devvit login",
    "playtest": "devvit playtest",
    "upload": "devvit upload",
    "publish": "devvit publish",
    "dev:server": "node dist/devserver/index.cjs",
    "build:devserver": "vite build --config vite.devserver.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@devvit/web": "0.14.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "devvit": "0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "private": true,
  "license": "BSD-3-Clause"
}
